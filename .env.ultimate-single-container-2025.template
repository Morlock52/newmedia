# ===============================================================================
# SYSTEM CONFIGURATION
# ===============================================================================

# User and Group IDs (should match your host system user)
PUID=1000
PGID=1000

# Timezone (use your local timezone)
TZ=America/New_York

# File creation mask (default: 002 for group write)
UMASK=002

# Domain configuration (for Traefik routing)
DOMAIN=media.local
SUBDOMAIN_PREFIX=

# ===============================================================================
# DIRECTORY PATHS
# ===============================================================================

# Main directories (relative to docker-compose.yml location)
CONFIG_PATH=./config
DATA_PATH=./data
LOGS_PATH=./logs
BACKUPS_PATH=./backups

# Media library paths
MOVIES_PATH=./media/movies
TV_PATH=./media/tv
MUSIC_PATH=./media/music
BOOKS_PATH=./media/books
AUDIOBOOKS_PATH=./media/audiobooks
PHOTOS_PATH=./media/photos
DOCUMENTS_PATH=./media/documents

# Download directories
DOWNLOADS_PATH=./downloads
WATCH_PATH=./watch
TORRENTS_PATH=./torrents
USENET_PATH=./usenet

# AI model storage
AI_MODELS_PATH=./models
OLLAMA_MODELS_PATH=./models/ollama
WHISPER_MODELS_PATH=./models/whisper

# ===============================================================================
# SECURITY CONFIGURATION
# ===============================================================================

# Security mode (enables additional security measures)
SECURE_MODE=true

# API Keys (generate with: openssl rand -hex 32)
API_KEY=your-secure-api-key-here-change-this-32-characters
REDIS_PASSWORD=your-redis-password-here-change-this
POSTGRES_PASSWORD=your-postgres-password-here-change-this

# Disable telemetry and analytics
DISABLE_TELEMETRY=true

# ===============================================================================
# FEATURE CONFIGURATION
# ===============================================================================

# AI and Machine Learning
AI_ENABLED=true
OLLAMA_MODELS=/models/ollama
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_CONTENT_ANALYSIS=true

# Monitoring and Analytics
ENABLE_MONITORING=true
ENABLE_METRICS_COLLECTION=true
ENABLE_PERFORMANCE_TRACKING=true

# Media Processing
ENABLE_HARDWARE_TRANSCODING=true
ENABLE_4K_TRANSCODING=true
ENABLE_HDR_TRANSCODING=false
TRANSCODING_THREADS=auto

# Backup and Sync
ENABLE_BACKUP=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
ENABLE_CLOUD_SYNC=false

# VPN Configuration (for download clients)
ENABLE_VPN=false
VPN_PROVIDER=nordvpn
VPN_COUNTRY=Switzerland
OPENVPN_USER=
OPENVPN_PASSWORD=

# ===============================================================================
# PORT CONFIGURATION
# ===============================================================================

# Primary access ports
MAIN_PORT=80
HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8088

# Media servers
JELLYFIN_PORT=8096
PLEX_PORT=32400
EMBY_PORT=8097

# *ARR Suite
SONARR_PORT=8989
RADARR_PORT=7878
LIDARR_PORT=8686
READARR_PORT=8787
BAZARR_PORT=6767
PROWLARR_PORT=9696

# Download clients
QBITTORRENT_PORT=8080
TRANSMISSION_PORT=9091
SABNZBD_PORT=8085
NZBGET_PORT=6789

# Request management
OVERSEERR_PORT=5055
JELLYSEERR_PORT=5056
OMBI_PORT=3579

# Dashboards
HOMEPAGE_PORT=3000
HOMARR_PORT=7575
ORGANIZR_PORT=8181
TAUTULLI_PORT=8182

# Content libraries
CALIBRE_WEB_PORT=8083
AUDIOBOOKSHELF_PORT=13378
NAVIDROME_PORT=4533
PHOTOPRISM_PORT=2342
IMMICH_PORT=2283
PAPERLESS_PORT=8010
NEXTCLOUD_PORT=8084
KOMGA_PORT=8090

# Utilities
VAULTWARDEN_PORT=8085
PIHOLE_PORT=8053
ADGUARD_PORT=8054
SYNCTHING_PORT=8384
FILEBROWSER_PORT=8086
CODE_SERVER_PORT=8443
GITEA_PORT=3002

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
UPTIME_KUMA_PORT=3001
PORTAINER_PORT=9000
NETDATA_PORT=19999
GLANCES_PORT=61208
SCRUTINY_PORT=8082

# AI services
AI_ASSISTANT_PORT=8090
AI_WEBSOCKET_PORT=8091
OLLAMA_PORT=11434

# Management
NGINX_PROXY_MANAGER_PORT=81
YACHT_PORT=8001

# ===============================================================================
# PERFORMANCE SETTINGS
# ===============================================================================

# Node.js configuration
NODE_OPTIONS=--max-old-space-size=4096
NODE_ENV=production

# Python configuration
PYTHON_WORKERS=4
PYTHON_ENV=production

# Database settings
POSTGRES_MAX_CONNECTIONS=100
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Transcoding settings
FFMPEG_THREADS=auto
HANDBRAKE_THREADS=auto

# ===============================================================================
# EXTERNAL API CONFIGURATION
# ===============================================================================

# Media databases (get free API keys from respective websites)
TMDB_API_KEY=
TVDB_API_KEY=
FANART_API_KEY=
OMDB_API_KEY=
MUSICBRAINZ_API_KEY=
LASTFM_API_KEY=

# Subtitle providers
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
SUBSCENE_USERNAME=
SUBSCENE_PASSWORD=

# Cloud storage (optional)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
DROPBOX_API_KEY=
ONEDRIVE_CLIENT_ID=

# ===============================================================================
# NOTIFICATION SETTINGS
# ===============================================================================

# Discord notifications
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=Ultimate Media Server
DISCORD_AVATAR_URL=

# Slack notifications
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#media-server
SLACK_USERNAME=Ultimate Media Server

# Email notifications
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_TLS=true

# Push notifications
PUSHBULLET_API_KEY=
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
NTFY_URL=
NTFY_TOPIC=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===============================================================================
# ADVANCED CONFIGURATION
# ===============================================================================

# Container resource limits (adjust based on your system)
CONTAINER_CPU_LIMIT=16.0
CONTAINER_MEMORY_LIMIT=32g
CONTAINER_CPU_RESERVATION=4.0
CONTAINER_MEMORY_RESERVATION=8g

# Network configuration
NETWORK_MTU=1500
DNS_SERVERS=1.1.1.1,8.8.8.8

# Logging configuration
LOG_LEVEL=INFO
LOG_MAX_SIZE=100m
LOG_MAX_FILES=3

# Debug settings (set to true for troubleshooting)
DEBUG_MODE=false
VERBOSE_LOGGING=false
ENABLE_DEBUG_API=false

# ===============================================================================
# MEDIA SERVER SPECIFIC SETTINGS
# ===============================================================================

# Jellyfin configuration
JELLYFIN_PUBLISHED_SERVER_URL=http://localhost:8096
JELLYFIN_AUTO_DISCOVERY=true

# Plex configuration
PLEX_CLAIM=
PLEX_ADVERTISE_IP=
PLEX_ALLOWED_NETWORKS=

# Emby configuration
EMBY_AUTO_RUN_SETUP=false

# ===============================================================================
# DOWNLOAD CLIENT CONFIGURATION
# ===============================================================================

# qBittorrent settings
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin
QBITTORRENT_USE_VPN=false

# Transmission settings
TRANSMISSION_USERNAME=admin
TRANSMISSION_PASSWORD=admin

# SABnzbd settings
SABNZBD_USERNAME=admin
SABNZBD_PASSWORD=admin

# NZBGet settings
NZBGET_USERNAME=nzbget
NZBGET_PASSWORD=tegbzn6789

# ===============================================================================
# DATABASE CONFIGURATION (ADVANCED)
# ===============================================================================

# PostgreSQL settings
POSTGRES_DB=mediaserver
POSTGRES_USER=postgres
POSTGRES_INITDB_ARGS=--encoding=UTF-8 --lc-collate=C --lc-ctype=C

# Redis settings
REDIS_DATABASES=16
REDIS_SAVE_ENABLED=true

# ===============================================================================
# SSL/TLS CONFIGURATION
# ===============================================================================

# Let's Encrypt settings (if using Traefik SSL)
ACME_EMAIL=admin@yourdomain.com
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
SSL_ENABLED=false
SSL_FORCE_REDIRECT=false

# ===============================================================================
# BACKUP CONFIGURATION
# ===============================================================================

# Backup settings
BACKUP_ENCRYPTION_KEY=
BACKUP_DESTINATION=local
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=

# ===============================================================================
# EXPERIMENTAL FEATURES
# ===============================================================================

# Experimental features (use at your own risk)
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_BETA_UPDATES=false
ENABLE_GPU_ACCELERATION=auto
ENABLE_NVIDIA_GPU=false
ENABLE_INTEL_QUICKSYNC=true
ENABLE_VAAPI=true

# AI experimental features
ENABLE_AI_UPSCALING=false
ENABLE_AI_SUBTITLES=false
ENABLE_AI_THUMBNAILS=false

# ===============================================================================
# CUSTOM CONFIGURATION
# ===============================================================================

# Add your custom environment variables below
# CUSTOM_VAR_1=value1
# CUSTOM_VAR_2=value2

