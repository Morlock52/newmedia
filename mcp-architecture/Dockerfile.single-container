# Ultimate Media Server 2025 - Single Container with ALL 30 Services
# This Dockerfile creates a single container running all media server applications
# with supervisor orchestration and Nginx reverse proxy

FROM ubuntu:22.04

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Set up environment variables
ENV PUID=1000
ENV PGID=1000
ENV UMASK=022

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # System utilities
    curl wget gpg software-properties-common apt-transport-https ca-certificates \
    supervisor nginx python3 python3-pip nodejs npm git unzip \
    # Media processing
    ffmpeg mediainfo \
    # Network utilities
    net-tools iputils-ping \
    # Archive utilities
    unrar p7zip-full \
    # Development tools
    build-essential \
    # Process management
    procps \
    && rm -rf /var/lib/apt/lists/*

# Create application directories
RUN mkdir -p /app /config /downloads /media/{movies,tv,music,books} \
    /var/log/supervisor /etc/supervisor/conf.d

# Install Node.js LTS
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs

# Install Jellyfin
RUN curl -fsSL https://repo.jellyfin.org/ubuntu/jellyfin_team.gpg.key | gpg --dearmor -o /etc/apt/trusted.gpg.d/jellyfin.gpg \
    && echo "deb [arch=$( dpkg --print-architecture )] https://repo.jellyfin.org/ubuntu $( lsb_release -c -s ) main" | tee /etc/apt/sources.list.d/jellyfin.list \
    && apt-get update && apt-get install -y jellyfin \
    && rm -rf /var/lib/apt/lists/*

# Install Plex Media Server
RUN curl -fsSL https://downloads.plex.tv/plex-keys/PlexSign.key | gpg --dearmor -o /etc/apt/trusted.gpg.d/plex.gpg \
    && echo "deb [arch=amd64] https://downloads.plex.tv/repo/deb public main" > /etc/apt/sources.list.d/plexmediaserver.list \
    && apt-get update && apt-get install -y plexmediaserver \
    && rm -rf /var/lib/apt/lists/*

# Download and install various media services
WORKDIR /tmp

# Install Sonarr
RUN curl -L -o sonarr.tar.gz "https://download.sonarr.tv/v3/main/3.0.10.1567/Sonarr.main.3.0.10.1567.linux-x64.tar.gz" \
    && tar -xzf sonarr.tar.gz -C /opt/ \
    && chown -R $PUID:$PGID /opt/Sonarr \
    && rm sonarr.tar.gz

# Install Radarr
RUN curl -L -o radarr.tar.gz "https://github.com/Radarr/Radarr/releases/download/v4.7.5.7809/Radarr.develop.4.7.5.7809.linux-core-x64.tar.gz" \
    && tar -xzf radarr.tar.gz -C /opt/ \
    && chown -R $PUID:$PGID /opt/Radarr \
    && rm radarr.tar.gz

# Install Lidarr
RUN curl -L -o lidarr.tar.gz "https://github.com/Lidarr/Lidarr/releases/download/v1.3.2.3516/Lidarr.develop.1.3.2.3516.linux-core-x64.tar.gz" \
    && tar -xzf lidarr.tar.gz -C /opt/ \
    && chown -R $PUID:$PGID /opt/Lidarr \
    && rm lidarr.tar.gz

# Install Readarr
RUN curl -L -o readarr.tar.gz "https://github.com/Readarr/Readarr/releases/download/v0.2.5.1955/Readarr.develop.0.2.5.1955.linux-core-x64.tar.gz" \
    && tar -xzf readarr.tar.gz -C /opt/ \
    && chown -R $PUID:$PGID /opt/Readarr \
    && rm readarr.tar.gz

# Install Bazarr
RUN git clone https://github.com/morpheus65535/bazarr.git /opt/bazarr \
    && chown -R $PUID:$PGID /opt/bazarr \
    && pip3 install -r /opt/bazarr/requirements.txt

# Install Prowlarr
RUN curl -L -o prowlarr.tar.gz "https://github.com/Prowlarr/Prowlarr/releases/download/v1.7.4.3769/Prowlarr.develop.1.7.4.3769.linux-core-x64.tar.gz" \
    && tar -xzf prowlarr.tar.gz -C /opt/ \
    && chown -R $PUID:$PGID /opt/Prowlarr \
    && rm prowlarr.tar.gz

# Install Jackett
RUN curl -L -o jackett.tar.gz "https://github.com/Jackett/Jackett/releases/download/v0.21.557/Jackett.Binaries.LinuxAMDx64.tar.gz" \
    && tar -xzf jackett.tar.gz -C /opt/ \
    && chown -R $PUID:$PGID /opt/Jackett \
    && rm jackett.tar.gz

# Install qBittorrent-nox
RUN add-apt-repository ppa:qbittorrent-team/qbittorrent-stable \
    && apt-get update && apt-get install -y qbittorrent-nox \
    && rm -rf /var/lib/apt/lists/*

# Install Transmission
RUN apt-get update && apt-get install -y transmission-daemon \
    && rm -rf /var/lib/apt/lists/*

# Install Deluge
RUN apt-get update && apt-get install -y deluge-daemon deluge-web \
    && rm -rf /var/lib/apt/lists/*

# Install SABnzbd
RUN add-apt-repository ppa:jcfp/nobetas \
    && apt-get update && apt-get install -y sabnzbdplus \
    && rm -rf /var/lib/apt/lists/*

# Install Python-based services
RUN pip3 install flexget

# Install Overseerr
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && git clone https://github.com/sct/overseerr.git /opt/overseerr \
    && cd /opt/overseerr && npm ci --only=production && npm run build \
    && chown -R $PUID:$PGID /opt/overseerr

# Install Tautulli
RUN git clone https://github.com/Tautulli/Tautulli.git /opt/tautulli \
    && chown -R $PUID:$PGID /opt/tautulli \
    && pip3 install -r /opt/tautulli/requirements.txt

# Install Homepage
RUN git clone https://github.com/benphelps/homepage.git /opt/homepage \
    && cd /opt/homepage && npm ci && npm run build \
    && chown -R $PUID:$PGID /opt/homepage

# Install Organizr
RUN git clone https://github.com/causefx/Organizr.git /opt/organizr \
    && chown -R $PUID:$PGID /opt/organizr

# Install Nginx Proxy Manager
RUN git clone https://github.com/NginxProxyManager/nginx-proxy-manager.git /opt/nginx-proxy-manager \
    && cd /opt/nginx-proxy-manager && npm ci --only=production \
    && chown -R $PUID:$PGID /opt/nginx-proxy-manager

# Install Portainer
RUN curl -L -o portainer.tar.gz "https://github.com/portainer/portainer/releases/download/2.19.1/portainer-2.19.1-linux-amd64.tar.gz" \
    && tar -xzf portainer.tar.gz -C /opt/ \
    && chown -R $PUID:$PGID /opt/portainer \
    && rm portainer.tar.gz

# Install additional utilities
RUN apt-get update && apt-get install -y \
    # Monitoring tools
    htop iotop nethogs \
    # Network tools
    netdata \
    # Archive tools
    unpackerr \
    && rm -rf /var/lib/apt/lists/*

# Copy application files
COPY src/ /app/src/
COPY public/ /app/public/
COPY package*.json /app/
COPY ultimate-single-container-mcp.js /app/

# Install Node.js dependencies
WORKDIR /app
RUN npm install --production

# Create configuration directories with proper permissions
RUN mkdir -p /config/{jellyfin,plex,emby,sonarr,radarr,lidarr,readarr,bazarr,prowlarr,jackett,qbittorrent,transmission,deluge,sabnzbd,overseerr,tautulli,homepage,organizr,nginx-proxy-manager,portainer} \
    && chown -R $PUID:$PGID /config /downloads /media /app

# Copy Nginx configuration
COPY config/nginx.conf /etc/nginx/nginx.conf

# Copy supervisor configuration
COPY config/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Create startup scripts
RUN echo '#!/bin/bash\n\
# Wait for services to be ready\n\
sleep 10\n\
\n\
# Start all services via supervisor\n\
exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf\n\
' > /app/start.sh && chmod +x /app/start.sh

# Health check script
RUN echo '#!/bin/bash\n\
# Check if main services are responding\n\
curl -f http://localhost:8090/health >/dev/null 2>&1 && \\\n\
curl -f http://localhost:8096/health >/dev/null 2>&1 && \\\n\
curl -f http://localhost:8989/api/v3/system/status >/dev/null 2>&1 && \\\n\
curl -f http://localhost:7878/api/v3/system/status >/dev/null 2>&1\n\
' > /app/healthcheck.sh && chmod +x /app/healthcheck.sh

# Expose all necessary ports
EXPOSE 80 81 3000 3001 3579 4545 5055 5656 6767 6789 7575 7878 8080 8081 8082 8085 8090 8096 8097 8112 8181 8191 8686 8787 8888 8989 9000 9091 9117 9696 19999 32400

# Set up volumes
VOLUME ["/config", "/downloads", "/media"]

# Set working directory
WORKDIR /app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /app/healthcheck.sh

# Default command
CMD ["/app/start.sh"]

# Labels
LABEL maintainer="Ultimate Media Server 2025"
LABEL description="Single container with all 30 media server services"
LABEL version="1.0.0"
LABEL services="jellyfin,plex,emby,sonarr,radarr,lidarr,readarr,bazarr,prowlarr,jackett,flaresolverr,qbittorrent,transmission,deluge,nzbget,sabnzbd,overseerr,requestrr,ombi,tautulli,netdata,homepage,heimdall,organizr,homarr,nginx-proxy-manager,portainer,watchtower,gluetun,unpackerr"