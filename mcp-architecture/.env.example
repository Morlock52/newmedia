# MediaServer MCP Suite Environment Configuration

# ================================
# OpenAI Configuration (Required)
# ================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=o1-mini

# ================================
# Server Configuration
# ================================
PORT=8090
NODE_ENV=development
LOG_LEVEL=info

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8090

# ================================
# Media Server URLs and API Keys
# ================================

# Jellyfin Configuration
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=your-jellyfin-api-key-here

# Sonarr Configuration  
SONARR_URL=http://localhost:8989
SONARR_API_KEY=your-sonarr-api-key-here

# Radarr Configuration
RADARR_URL=http://localhost:7878
RADARR_API_KEY=your-radarr-api-key-here

# Prowlarr Configuration
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=your-prowlarr-api-key-here

# qBittorrent Configuration
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# ================================
# AI Agent Voting System
# ================================

# Consensus threshold (0.0 to 1.0)
CONSENSUS_THRESHOLD=0.7

# Voting timeout in minutes
VOTE_TIMEOUT_MINUTES=5

# ================================
# Social Media Research APIs
# ================================

# Twitter/X API Configuration
TWITTER_API_KEY=your-twitter-api-key-here
TWITTER_API_SECRET=your-twitter-api-secret-here
TWITTER_ACCESS_TOKEN=your-twitter-access-token-here
TWITTER_ACCESS_SECRET=your-twitter-access-secret-here

# Reddit API Configuration  
REDDIT_CLIENT_ID=your-reddit-client-id-here
REDDIT_CLIENT_SECRET=your-reddit-client-secret-here
REDDIT_USER_AGENT=MediaServerMCP/1.0

# ================================
# Database Configuration (Optional)
# ================================
# For persistent storage of voting history and agent data

# DATABASE_TYPE=sqlite
# DATABASE_PATH=./data/mediaserver-mcp.db

# For PostgreSQL:
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://username:password@localhost:5432/mediaserver_mcp

# ================================
# Security Configuration
# ================================

# JWT Secret for session management
JWT_SECRET=your-super-secret-jwt-key-here

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# Container/Docker Configuration
# ================================

# If running in Docker, these should match your container setup
JELLYFIN_URL=http://jellyfin:8096
SONARR_URL=http://sonarr:8989
RADARR_URL=http://radarr:7878
PROWLARR_URL=http://prowlarr:9696
QBITTORRENT_URL=http://qbittorrent:8080

# ================================
# Development Configuration
# ================================

# Enable debug logging
DEBUG=mediaserver:*

# Hot reload for development
NODEMON_WATCH=true

# Mock services for testing (set to true to use mock data)
MOCK_SERVICES=false

# ================================
# Performance Configuration
# ================================

# Number of worker processes (0 = auto-detect CPU cores)
WORKER_PROCESSES=0

# Memory limit for Node.js (MB)
NODE_MAX_OLD_SPACE_SIZE=2048

# ================================
# Monitoring and Analytics
# ================================

# Enable performance monitoring
ENABLE_MONITORING=true

# Metrics collection interval (seconds)
METRICS_INTERVAL=30

# ================================
# Advanced AI Configuration
# ================================

# Temperature for AI responses (0.0 to 2.0)
AI_TEMPERATURE=0.7

# Maximum tokens for AI responses
AI_MAX_TOKENS=1000

# Agent response timeout (milliseconds)
AGENT_TIMEOUT=30000

# Enable social research integration
ENABLE_SOCIAL_RESEARCH=true

# ================================
# Backup and Recovery
# ================================

# Backup directory for voting history and agent data
BACKUP_DIRECTORY=./backups

# Automatic backup interval (hours)
BACKUP_INTERVAL_HOURS=24

# ================================
# Notification Configuration
# ================================

# Webhook URL for system notifications
NOTIFICATION_WEBHOOK_URL=

# Email notifications (if configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=

# ================================
# Usage Notes
# ================================

# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control
# 3. OpenAI API key is required for the AI agents to function
# 4. Media server API keys can be found in each service's settings
# 5. Social media APIs are optional but enhance recommendation features
# 6. For Docker deployment, use service names instead of localhost URLs
# 7. Ensure all ports match your actual service configurations