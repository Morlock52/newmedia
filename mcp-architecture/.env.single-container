# Ultimate Media Server 2025 - Single Container Environment Configuration
# Copy this file to .env and configure your settings

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# User and Group IDs
PUID=1000
PGID=1000
UMASK=022

# Timezone
TZ=UTC

# Resource Limits
MAX_MEMORY=16G
MAX_CPUS=8.0
MIN_MEMORY=4G
MIN_CPUS=2.0

# =============================================================================
# DIRECTORY PATHS
# =============================================================================

# Media directories
MEDIA_ROOT=./media
DOWNLOADS_ROOT=./downloads
INCOMPLETE_ROOT=./incomplete-downloads
WATCH_ROOT=./watch
BACKUP_ROOT=./backups
CONFIG_ROOT=./config

# =============================================================================
# REQUIRED: OPENAI CONFIGURATION (for MCP functionality)
# =============================================================================

# OpenAI API Key (REQUIRED - Get from https://platform.openai.com)
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI Model Selection
OPENAI_MODEL=o1-mini

# =============================================================================
# MEDIA SERVER API KEYS
# =============================================================================

# Jellyfin API Key (Generated in Jellyfin -> Dashboard -> API Keys)
JELLYFIN_API_KEY=your-jellyfin-api-key

# Plex Token (Get from https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/)
PLEX_TOKEN=your-plex-token

# Emby API Key (Generated in Emby -> Settings -> Advanced -> API Keys)
EMBY_API_KEY=your-emby-api-key

# =============================================================================
# CONTENT MANAGEMENT (*ARR SUITE) API KEYS
# =============================================================================

# Sonarr API Key (Settings -> General -> Security -> API Key)
SONARR_API_KEY=your-sonarr-api-key

# Radarr API Key (Settings -> General -> Security -> API Key)
RADARR_API_KEY=your-radarr-api-key

# Lidarr API Key (Settings -> General -> Security -> API Key)
LIDARR_API_KEY=your-lidarr-api-key

# Readarr API Key (Settings -> General -> Security -> API Key)
READARR_API_KEY=your-readarr-api-key

# Bazarr API Key (Settings -> General -> Security -> API Key)
BAZARR_API_KEY=your-bazarr-api-key

# =============================================================================
# INDEXER API KEYS
# =============================================================================

# Prowlarr API Key (Settings -> General -> Security -> API Key)
PROWLARR_API_KEY=your-prowlarr-api-key

# Jackett API Key (Settings -> Jackett Config -> API Key)
JACKETT_API_KEY=your-jackett-api-key

# =============================================================================
# DOWNLOAD CLIENT CONFIGURATION
# =============================================================================

# qBittorrent
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# Transmission
TRANSMISSION_USERNAME=admin
TRANSMISSION_PASSWORD=admin

# Deluge
DELUGE_PASSWORD=deluge

# SABnzbd
SABNZBD_API_KEY=your-sabnzbd-api-key

# NZBGet
NZBGET_USERNAME=nzbget
NZBGET_PASSWORD=tegbzn6789

# =============================================================================
# REQUEST SYSTEM API KEYS
# =============================================================================

# Overseerr API Key (Settings -> General -> API Key)
OVERSEERR_API_KEY=your-overseerr-api-key

# Requestrr API Key (Bot Settings -> API)
REQUESTRR_API_KEY=your-requestrr-api-key

# Ombi API Key (Settings -> Ombi -> API Key)
OMBI_API_KEY=your-ombi-api-key

# =============================================================================
# ANALYTICS API KEYS
# =============================================================================

# Tautulli API Key (Settings -> Web Interface -> API -> API Key)
TAUTULLI_API_KEY=your-tautulli-api-key

# =============================================================================
# INFRASTRUCTURE CONFIGURATION
# =============================================================================

# Database Configuration
DB_NAME=ultimatemedia
DB_USER=ultimateuser
DB_PASSWORD=ultimatepass123

# Redis Cache
REDIS_PASSWORD=ultimatecache123

# Nginx Proxy Manager
NGINX_PM_DB_PASS=changeme

# Portainer
PORTAINER_ADMIN_PASSWORD=your-portainer-password

# =============================================================================
# VPN CONFIGURATION (Optional)
# =============================================================================

# Enable VPN protection for download clients
ENABLE_VPN=false

# VPN Provider (surfshark, nordvpn, expressvpn, etc.)
VPN_PROVIDER=surfshark

# VPN Type (wireguard, openvpn)
VPN_TYPE=wireguard

# Wireguard Configuration (if using Wireguard)
WIREGUARD_PRIVATE_KEY=your-wireguard-private-key
WIREGUARD_ADDRESSES=10.64.0.1/32

# VPN Server Region
VPN_REGIONS=United States

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret for authentication (generate a random string)
JWT_SECRET=your-jwt-secret-here-make-it-long-and-random

# Admin Configuration
ADMIN_EMAIL=admin@localhost
DEFAULT_ADMIN_PASSWORD=changeme123

# =============================================================================
# OPTIONAL: SOCIAL MEDIA AND AI INTEGRATIONS
# =============================================================================

# Twitter API (for trending content discovery)
TWITTER_API_KEY=your-twitter-api-key

# Reddit API (for content recommendations)
REDDIT_CLIENT_ID=your-reddit-client-id

# Discord Bot (for Requestrr integration)
DISCORD_BOT_TOKEN=your-discord-bot-token

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable automatic updates via Watchtower
ENABLE_AUTO_UPDATE=true

# Enable system monitoring via Netdata
ENABLE_MONITORING=true

# Enable automatic backups
ENABLE_BACKUP=true

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Node.js Environment
NODE_ENV=production

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info

# AI Consensus Threshold (0.1 to 1.0)
CONSENSUS_THRESHOLD=0.7

# AI Vote Timeout (minutes)
VOTE_TIMEOUT_MINUTES=5

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Network Configuration
NETWORK_SUBNET=172.30.0.0/16
NETWORK_GATEWAY=172.30.0.1

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=15s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=120s

# Backup Retention
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true

# =============================================================================
# QUICK SETUP GUIDE
# =============================================================================

# 1. REQUIRED SETUP:
#    - Set OPENAI_API_KEY (required for MCP functionality)
#    - Update passwords (search for 'changeme' and 'your-' values)
#    - Create media directories: mkdir -p media/{movies,tv,music,books} downloads config backups

# 2. FIRST RUN:
#    docker-compose -f docker-compose.single-container.yml up -d

# 3. ACCESS SERVICES:
#    - Ultimate Dashboard: http://localhost:8090
#    - Jellyfin: http://localhost:8096
#    - Sonarr: http://localhost:8989
#    - Radarr: http://localhost:7878
#    - Prowlarr: http://localhost:9696
#    - qBittorrent: http://localhost:8080

# 4. CONFIGURE SERVICES:
#    - Set up each service through their web interfaces
#    - Generate API keys and update this .env file
#    - Restart: docker-compose -f docker-compose.single-container.yml restart

# 5. MCP INTEGRATION:
#    - MCP Server: http://localhost:3000
#    - Claude Desktop Config: Add to ~/Library/Application Support/Claude/claude_desktop_config.json

# =============================================================================
# TROUBLESHOOTING
# =============================================================================

# View logs: docker-compose -f docker-compose.single-container.yml logs -f
# Restart services: docker-compose -f docker-compose.single-container.yml restart
# Check health: docker-compose -f docker-compose.single-container.yml ps
# Shell access: docker exec -it ultimate-media-server-2025 bash

# =============================================================================
# SECURITY NOTES
# =============================================================================

# - Change all default passwords before deployment
# - Use strong, unique passwords for all services
# - Keep API keys secure and rotate them regularly
# - Enable VPN for download clients in production
# - Use reverse proxy with SSL certificates
# - Regularly update the container image