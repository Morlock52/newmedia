{
  "name": "newmedia-server",
  "version": "1.0.0",
  "description": "Comprehensive media server management API with Socket.IO integration",
  "main": "real-backend-server.js",
  "scripts": {
    "start": "node start-real-backend.js",
    "start:real": "node start-real-backend.js",
    "start:performance": "node performance-optimized-api.js",
    "dev": "nodemon start-real-backend.js",
    "dev:real": "nodemon start-real-backend.js",
    "dev:performance": "nodemon performance-optimized-api.js",
    "test:real": "node test-real-backend.js",
    "socket": "node api/socket-server.js",
    "test": "jest",
    "test:backend": "node test-real-backend.js",
    "test:performance": "node performance-test-suite.js",
    "test:lighthouse": "lighthouse http://localhost:3004 --output json --output html --output-path ./performance-reports/lighthouse",
    "build": "webpack --config webpack.performance.config.js --mode production",
    "build:dev": "webpack --config webpack.performance.config.js --mode development",
    "build:analyze": "webpack-bundle-analyzer dist/stats.json",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build:backend": "docker build -t newmedia-backend:local -f Dockerfile.backend .",
    "docker:run:backend": "docker run --rm -p 3333:3333 --name newmedia-backend newmedia-backend:local",
    "docker:test:backend": "sh -c 'docker run -d -p 3333:3333 --name newmedia-backend newmedia-backend:local && sleep 2 && curl -fsS http://127.0.0.1:3333/health && docker rm -f newmedia-backend >/dev/null'",
    "health": "curl http://localhost:3333/health || true",
    "performance:monitor": "node performance-monitor.js",
    "performance:report": "node performance-report-generator.js",
    "performance:benchmark": "node performance-test-suite.js --benchmark",
    "performance:optimize-db": "node database-performance-optimizer.js",
    "performance:analyze": "npm run build:analyze && npm run performance:report",
    "sw:update": "workbox generateSW workbox-config.js",
    "pwa:test": "node -e \"console.log('Open http://localhost:3004/pwa-test.html to test PWA features')\"",
    "cache:clear": "node -e \"require('fs').rmSync('./cache', {recursive: true, force: true}); console.log('Cache cleared')\"",
    "lint:performance": "eslint performance-*.js --fix",
    "audit:performance": "npm audit && lighthouse-ci collect --url=http://localhost:3004",
    "test:ui:playwright": "playwright test",
    "playwright:install": "npx playwright install --with-deps",
    "test:realtime": "node tests/voice/run-realtime-test.js",
    "test:webrtc": "node tests/voice/webrtc-client-test.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.0.8",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.2.2",
    "claude-flow": "^2.0.0-alpha.73",
    "colors": "^1.4.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "imagemin": "^8.0.1",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^9.0.2",
    "imagemin-webp": "^8.0.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "redis": "^4.6.10",
    "sharp": "^0.33.1",
    "socket.io": "^4.7.5",
    "sqlite3": "^5.1.6",
    "web-vitals": "^3.5.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "wrtc": "^0.4.7",
    "prom-client": "^14.0.1",
    "workbox-sw": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-react": "^7.23.3",
    "@types/jest": "^29.5.8",
    "0x": "^5.5.0",
    "autocannon": "^7.12.0",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "babel-plugin-transform-react-constant-elements": "^6.23.0",
    "babel-plugin-transform-react-inline-elements": "^6.22.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "chalk": "^5.4.1",
    "clinic": "^13.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "cssnano": "^6.0.2",
    "eslint": "^8.54.0",
    "html-webpack-plugin": "^5.5.4",
    "jest": "^29.7.0",
    "lighthouse": "^11.4.0",
    "mini-css-extract-plugin": "^2.7.6",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.32",
    "postcss-custom-media": "^10.0.2",
    "postcss-import": "^15.1.0",
    "postcss-loader": "^7.3.3",
    "postcss-nested": "^6.0.1",
    "prettier": "^3.1.0",
    "puppeteer": "^21.5.2",
    "react-refresh": "^0.14.0",
    "stylelint": "^15.11.0",
    "supertest": "^6.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "workbox-webpack-plugin": "^7.0.0",
    "ws": "^8.18.3",
    "@playwright/test": "^1.46.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "media-server",
    "docker",
    "api",
    "socket.io",
    "jellyfin",
