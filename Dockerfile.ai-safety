# Dockerfile for AI Safety System
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    cmake \
    build-essential \
    libffi-dev \
    libssl-dev \
    python3-dev \
    pkg-config \
    libhdf5-dev \
    libatlas-base-dev \
    gfortran \
    libjpeg-dev \
    libpng-dev \
    libopencv-dev \
    ffmpeg \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements-ai-safety.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-ai-safety.txt

# Copy AI safety system files
COPY ai-safety-system.py .
COPY ai-models/ ./models/
COPY ai-safety-config/ ./config/

# Create necessary directories
RUN mkdir -p /app/data /app/logs /app/temp

# Set environment variables
ENV PYTHONPATH=/app
ENV CUDA_VISIBLE_DEVICES=0
ENV MODEL_CACHE_PATH=/app/models
ENV DATABASE_PATH=/app/data/ai_safety.db
ENV LOG_LEVEL=info

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run the AI safety system
CMD ["python", "ai-safety-system.py"]