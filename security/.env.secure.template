# Secure Environment Configuration Template
# Copy this file to .env and update with your secure values
# Generated: August 3, 2025

# =============================================================================
# 🔒 SECURITY CONFIGURATION
# =============================================================================

# Master Encryption Key (Generate with: openssl rand -hex 32)
MASTER_ENCRYPTION_KEY=your-32-byte-hex-key-here

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Session Configuration
SESSION_SECRET=your-session-secret-here
SESSION_MAX_AGE=900000

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=5

# =============================================================================
# 🎯 MEDIA SERVER CONFIGURATION
# =============================================================================

# Jellyfin Configuration
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=your-jellyfin-api-key-here
JELLYFIN_USERNAME=your-jellyfin-username
JELLYFIN_PASSWORD=your-jellyfin-password

# Sonarr Configuration
SONARR_URL=http://localhost:8989
SONARR_API_KEY=your-sonarr-api-key-here

# Radarr Configuration
RADARR_URL=http://localhost:7878
RADARR_API_KEY=your-radarr-api-key-here

# Prowlarr Configuration
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=your-prowlarr-api-key-here

# qBittorrent Configuration
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=your-qbittorrent-username
QBITTORRENT_PASSWORD=your-qbittorrent-password

# =============================================================================
# 🐳 DOCKER CONFIGURATION
# =============================================================================

# User IDs for container security
PUID=1000
PGID=1000

# Container Security
DOCKER_SOCK_READONLY=true
CONTAINER_USER=mediauser
CONTAINER_GROUP=mediagroup

# =============================================================================
# 🛡️ SECURITY MONITORING
# =============================================================================

# Security Monitor Configuration
SECURITY_MONITOR_ENABLED=true
SECURITY_ALERT_EMAIL=security@yourdomain.com
SECURITY_WEBHOOK_URL=https://your-webhook-url.com/security-alerts

# Vulnerability Scanner
VULN_SCAN_ENABLED=true
VULN_SCAN_INTERVAL=86400

# =============================================================================
# 📊 LOGGING & MONITORING
# =============================================================================

# Log Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/app/logs/security.log
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10

# Performance Monitoring
PERFORMANCE_MONITORING=true
METRICS_PORT=3001
METRICS_ENDPOINT=/metrics

# =============================================================================
# 🌐 NETWORK CONFIGURATION
# =============================================================================

# Server Configuration
SERVER_PORT=3000
SERVER_HOST=localhost
SERVER_HTTPS=true

# SSL/TLS Configuration
SSL_CERT_PATH=/app/certs/server.crt
SSL_KEY_PATH=/app/certs/server.key
SSL_CA_PATH=/app/certs/ca.crt

# CORS Configuration
CORS_ORIGIN=https://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# =============================================================================
# 🔄 BACKUP & RECOVERY
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/app/backups

# Database Backup
DB_BACKUP_ENABLED=true
DB_BACKUP_ENCRYPTION=true

# =============================================================================
# 🎨 APPLICATION FEATURES
# =============================================================================

# Feature Flags
ENABLE_VOICE_AI=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_SECURITY_SCANNING=true
ENABLE_REAL_TIME_ANALYTICS=true

# AI Features
OPENAI_API_KEY=your-openai-api-key-here
AZURE_SPEECH_KEY=your-azure-speech-key-here
GOOGLE_CLOUD_KEY=your-google-cloud-key-here

# =============================================================================
# 🚀 PRODUCTION SETTINGS
# =============================================================================

# Environment
NODE_ENV=production
DEBUG=false

# Resource Limits
MAX_MEMORY_USAGE=2GB
MAX_CPU_USAGE=80
MAX_DISK_USAGE=90

# Health Checks
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# =============================================================================
# 📱 NOTIFICATIONS
# =============================================================================

# Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
SLACK_CHANNEL=#security-alerts

# Discord Notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/discord/webhook

# =============================================================================
# 🔧 DEVELOPMENT SETTINGS (Remove in production)
# =============================================================================

# Development only - remove these in production
DEV_MODE=false
MOCK_AUTH=false
SKIP_SSL_VERIFY=false
DEBUG_SECURITY=false

# =============================================================================
# 📋 NOTES
# =============================================================================

# 1. Generate secure keys using: openssl rand -hex 32
# 2. Never commit this file with real values to version control
# 3. Use environment-specific .env files (.env.dev, .env.prod, etc.)
# 4. Regularly rotate secrets and API keys
# 5. Monitor access logs for suspicious activity
# 6. Enable two-factor authentication where possible
# 7. Use strong, unique passwords for all services
# 8. Keep API keys and secrets in secure vault systems for production