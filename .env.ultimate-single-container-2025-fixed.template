# ===============================================================================
# PERFORMANCE SETTINGS - 2025 OPTIMIZATIONS
# ===============================================================================

# Node.js configuration with increased memory
NODE_OPTIONS=--max-old-space-size=8192 --max-semi-space-size=1024
NODE_ENV=production

# Python configuration with optimizations
PYTHON_WORKERS=4
PYTHON_ENV=production
PYTHONOPTIMIZE=1
PYTHONUNBUFFERED=1

# .NET configuration
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
