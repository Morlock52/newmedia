# Ultimate Media Server 2025 Configuration Template
# Copy this file to .env and customize the values

# System Settings
TZ=America/New_York
PUID=1000
PGID=1000

# Domain Settings
DOMAIN=localhost
JELLYFIN_EXTERNAL_URL=http://localhost:8096

# Port Configuration
DASHBOARD_PORT=80
API_PORT=3002
JELLYFIN_PORT=8096
SONARR_PORT=8989
RADARR_PORT=7878
LIDARR_PORT=8686
PROWLARR_PORT=9696
BAZARR_PORT=6767
QBITTORRENT_PORT=8080
SABNZBD_PORT=8085
TRANSMISSION_PORT=9091
UPTIME_KUMA_PORT=3001

# Directory Paths
CONFIG_PATH=./config
MEDIA_PATH=./media
DOWNLOADS_PATH=./downloads
LOGS_PATH=./logs
BACKUPS_PATH=./backups
WATCH_PATH=./watch
IMPORT_PATH=./import

# Security Settings
SECURE_MODE=true
API_KEY=change-this-secure-api-key

# Performance Settings
ENABLE_HARDWARE_TRANSCODING=true

# ==================== INFRASTRUCTURE CONFIGURATION ====================

# SSL/TLS Configuration
ACME_EMAIL=admin@example.com
SSL_CERT_PATH=./traefik/certs

# Authentication & Security
AUTHELIA_JWT_SECRET=your-super-secure-jwt-secret-here-minimum-32-chars
AUTHELIA_SESSION_SECRET=your-super-secure-session-secret-here-minimum-32-chars
AUTHELIA_STORAGE_ENCRYPTION_KEY=your-super-secure-storage-encryption-key-here-minimum-32-chars

# VPN Configuration
VPN_PROVIDER=nordvpn
VPN_TYPE=openvpn
OPENVPN_USER=your-vpn-username
OPENVPN_PASSWORD=your-vpn-password
VPN_COUNTRY=Switzerland
VPN_UNBLOCK=

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure-postgres-password
MYSQL_ROOT_PASSWORD=secure-mysql-root-password
NPM_DB_PASSWORD=secure-npm-db-password

# Monitoring & Alerting
GRAFANA_USER=admin
GRAFANA_PASSWORD=secure-grafana-password
ALERT_EMAIL_FROM=alerts@example.com
ADMIN_EMAIL=admin@example.com

# SMTP Configuration for Notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# API Keys for Services
SONA RR_API_KEY=your-sonarr-api-key
RADARR_API_KEY=your-radarr-api-key
PROWLARR_API_KEY=your-prowlarr-api-key
JELLYFIN_API_KEY=your-jellyfin-api-key
JELLYFIN_METRICS_USER=metrics
JELLYFIN_METRICS_PASSWORD=metrics-password

# Webhook Secrets
SONARR_WEBHOOK_SECRET=secure-sonarr-webhook-secret
RADARR_WEBHOOK_SECRET=secure-radarr-webhook-secret

# FileFlows Configuration
FILEFLOWS_API_URL=http://fileflows:5000
FILEFLOWS_API_KEY=your-fileflows-api-key

# Media Server URLs
JELLYFIN_URL=http://jellyfin:8096
SONARR_URL=http://sonarr:8989
RADARR_URL=http://radarr:7878
PROWLARR_URL=http://prowlarr:9696

# Optional: DUO 2FA Configuration
# DUO_HOSTNAME=api-xxxxxxxx.duosecurity.com
# DUO_INTEGRATION_KEY=your-duo-integration-key
# DUO_SECRET_KEY=your-duo-secret-key

# Optional: External Services
# GRAFANA_WEBHOOK_URL=https://your-grafana-webhook-url
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/discord/webhook

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# Advanced Security Settings
FAIL2BAN_ENABLED=true
SECURITY_HEADERS_ENABLED=true
RATE_LIMITING_ENABLED=true

# Performance Tuning
PROMETHEUS_RETENTION_DAYS=15
LOKI_RETENTION_DAYS=7
GRAFANA_PLUGINS=grafana-clock-panel,grafana-piechart-panel,grafana-worldmap-panel

# Network Configuration
DOCKER_NETWORK_SUBNET=172.30.0.0/16
VPN_NETWORK_SUBNET=172.32.0.0/16
MONITORING_NETWORK_SUBNET=172.33.0.0/16
SECURITY_NETWORK_SUBNET=172.35.0.0/16

# Resource Limits
JELLYFIN_CPU_LIMIT=4
JELLYFIN_MEMORY_LIMIT=4g
PROMETHEUS_MEMORY_LIMIT=2g
GRAFANA_MEMORY_LIMIT=512m

# GPU Configuration (if available)
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,video,utility

# Development/Debug Settings
DEBUG_MODE=false
LOG_LEVEL=INFO
ENABLE_METRICS=true
ENABLE_TRACING=false

# ==================== OPTIONAL INTEGRATIONS ====================

# Home Assistant Integration
# HOME_ASSISTANT_URL=http://homeassistant:8123
# HOME_ASSISTANT_TOKEN=your-ha-long-lived-access-token

# Plex Integration
# PLEX_CLAIM=claim-xxxxxxxxxx
# PLEX_TOKEN=your-plex-token

# Nextcloud Integration
# NEXTCLOUD_USER=admin
# NEXTCLOUD_PASSWORD=admin
# NEXTCLOUD_DOMAIN=localhost

# PhotoPrism Integration
# PHOTOPRISM_USER=admin
# PHOTOPRISM_PASSWORD=insecure
# PHOTOPRISM_DB_PASSWORD=photoprism

# Paperless-NGX Integration
# PAPERLESS_SECRET_KEY=changeme
# PAPERLESS_USER=admin
# PAPERLESS_PASSWORD=admin

# Vaultwarden Integration
# VAULTWARDEN_DOMAIN=http://localhost
# VAULTWARDEN_SIGNUPS=true
# VAULTWARDEN_TOKEN=changeme

# AdGuard/Pi-hole Integration
# PIHOLE_PASSWORD=admin

# Code Server Integration
# CODE_SERVER_PASSWORD=password
# CODE_SERVER_SUDO_PASSWORD=password

# Watchtower Email Notifications
# EMAIL_FROM=watchtower@example.com
# EMAIL_TO=admin@example.com

# Homarr Dashboard Configuration
# HOMARR_URL=http://localhost:7575
# HOMARR_PASSWORD=

# END OF CONFIGURATION