  "shortcuts": [
    {
      "name": "Dashboard",
      "url": "/dashboard",
      "description": "Open main dashboard",
      "icons": [
        {
          "src": "/icons/dashboard.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Downloads",
      "url": "/downloads",
      "description": "Manage downloads",
      "icons": [
        {
          "src": "/icons/downloads.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Media Library",
      "url": "/library",
      "description": "Browse media",
      "icons": [
        {
          "src": "/icons/library.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "features": [
    "Cross Platform",
    "Low Latency",
    "Secure Storage",
    "Offline Capable"
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["video/*", "audio/*", "image/*"]
        }
      ]
    }
  }
}