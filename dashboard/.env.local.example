# Next.js Environment Variables
NEXT_PUBLIC_APP_NAME=Ultimate Media Dashboard 2025
NEXT_PUBLIC_APP_VERSION=2.0.0

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3010/ws

# Service URLs (Override defaults if needed)
NEXT_PUBLIC_JELLYFIN_URL=http://localhost:8096
NEXT_PUBLIC_PLEX_URL=http://localhost:32400
NEXT_PUBLIC_SONARR_URL=http://localhost:8989
NEXT_PUBLIC_RADARR_URL=http://localhost:7878
NEXT_PUBLIC_PROWLARR_URL=http://localhost:9696
NEXT_PUBLIC_QBITTORRENT_URL=http://localhost:8080

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_REAL_TIME_UPDATES=true
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# Development
NODE_ENV=development
NEXT_PUBLIC_DEBUG_MODE=true

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Authentication (If implemented)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# External Services
DOCKER_SOCKET_PATH=/var/run/docker.sock
MONITORING_ENDPOINT=http://localhost:3010