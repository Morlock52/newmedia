# ============================================================================
# PRODUCTION-OPTIMIZED MEDIA SERVER CONFIGURATION
# Copy this file to .env and customize the values
# ============================================================================

# ==================== SYSTEM SETTINGS ====================
TZ=America/New_York
PUID=1000
PGID=1000

# ==================== DOMAIN & SSL SETTINGS ====================
DOMAIN=localhost
# For production, use your actual domain: DOMAIN=yourdomain.com

# SSL Certificate Settings (Let's Encrypt)
ACME_EMAIL=admin@example.com
# Use production CA for real certificates
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# For production: ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# ==================== DIRECTORY PATHS ====================
# Ensure these directories exist and have correct permissions
MEDIA_PATH=./media
DOWNLOADS_PATH=./downloads
CONFIG_PATH=./config
LOGS_PATH=./logs
BACKUPS_PATH=./backups

# ==================== MEDIA SERVICES ====================
# Plex Settings
PLEX_CLAIM=
# Get your claim token from https://plex.tv/claim

# ==================== SECURITY SETTINGS ====================
# Database Passwords (CHANGE THESE!)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=media_server

REDIS_PASSWORD=your_secure_redis_password_here

# Grafana Admin
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_secure_grafana_password_here

# ==================== PERFORMANCE SETTINGS ====================
# Hardware Acceleration
ENABLE_HARDWARE_ACCELERATION=true

# Resource Limits (adjust based on your system)
# CPU cores available for high-resource services
HIGH_CPU_LIMIT=4.0
HIGH_MEMORY_LIMIT=8G

# CPU cores for standard services  
STANDARD_CPU_LIMIT=2.0
STANDARD_MEMORY_LIMIT=2G

# CPU cores for low-resource services
LOW_CPU_LIMIT=1.0
LOW_MEMORY_LIMIT=512M

# ==================== NETWORKING ====================
# Docker Network Subnets
MEDIA_SUBNET=172.30.0.0/16
SECURE_SUBNET=172.31.0.0/16

# ==================== DOWNLOAD CLIENT SETTINGS ====================
# qBittorrent
QBT_WEBUI_PORT=8081
QBT_CONNECTION_PORT=6881

# SABnzbd
SABNZBD_API_KEY=your_sabnzbd_api_key_here

# ==================== MONITORING ====================
# Prometheus retention
PROMETHEUS_RETENTION=30d

# Health check intervals
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ==================== BACKUP SETTINGS ====================
# Automated backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ==================== LOG SETTINGS ====================
LOG_LEVEL=info
LOG_MAX_SIZE=100m
LOG_MAX_FILES=3

# ==================== VPN SETTINGS (Optional) ====================
# Uncomment and configure if using VPN
# VPN_PROVIDER=nordvpn
# VPN_TYPE=openvpn
# OPENVPN_USER=your_vpn_username
# OPENVPN_PASSWORD=your_vpn_password
# VPN_COUNTRY=Switzerland

# ==================== NOTIFICATION SETTINGS (Optional) ====================
# Email notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=admin@yourdomain.com

# ==================== ADVANCED SETTINGS ====================
# Docker socket security (set to true for production)
DOCKER_SOCKET_READONLY=true

# Container restart policy
RESTART_POLICY=unless-stopped

# Network MTU (adjust if needed)
NETWORK_MTU=1500

# ==================== DEVELOPMENT SETTINGS ====================
# Set to false for production
DEBUG_MODE=false
DEVELOPMENT_MODE=false

# API Rate limiting
API_RATE_LIMIT=100
API_RATE_WINDOW=60

# ==================== EXPERIMENTAL FEATURES ====================
# Enable beta features (use with caution)
ENABLE_EXPERIMENTAL_FEATURES=false

# IPv6 Support
ENABLE_IPV6=false

# Container privileged mode (only enable if needed)
PRIVILEGED_MODE=false