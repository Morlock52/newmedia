# API Server Dockerfile - Node.js Production
FROM node:25-bullseye-slim

WORKDIR /app

# Install dependencies for system monitoring
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    python3-dev \
    pkg-config \
    libopus-dev \
    libvpx-dev \
    libssl-dev \
    curl \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY api/package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy application files
COPY api/ ./
# Add console shim for structured logging inside container
COPY scripts/console-shim.js ./scripts/console-shim.js

# Create logs directory
RUN mkdir -p /var/log/api

# Expose port
EXPOSE 3002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3002/health || exit 1

# Start the application
CMD ["node", "-r", "./scripts/console-shim.js", "server.js"]