# Stage 6: Final optimized image
FROM base-builder

# Copy all components from previous stages
COPY --from=s6-downloader /s6-overlay /
COPY --from=caddy-downloader /usr/bin/caddy /usr/local/bin/caddy
COPY --from=arr-downloader /arr-apps /opt
COPY --from=monitoring-downloader /monitoring /opt
COPY --from=node-builder /homepage-dist /opt/homepage

# Install Jellyfin from official repository  
RUN mkdir -p /etc/apt/keyrings && \
    curl https://repo.jellyfin.org/jellyfin_team.gpg.key | gpg --dearmor --yes --output /etc/apt/keyrings/jellyfin.gpg && \
    chmod 644 /etc/apt/keyrings/jellyfin.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/jellyfin.gpg] https://repo.jellyfin.org/debian $(lsb_release -cs) main" > /etc/apt/sources.list.d/jellyfin.sources

# Install Node.js from NodeSource
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash -

# Install all runtime packages in single layer for efficiency
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Media server packages
    jellyfin \
    jellyfin-web \
    jellyfin-ffmpeg6 \
    # Download clients
    qbittorrent-nox \
    # Node.js for dashboard and MCP
    nodejs \
    # Monitoring tools
    redis-server \
    # Backup tools
    borgbackup \
    restic \
    rclone \
    # Security tools
    fail2ban \
    ufw \
    # Process monitoring
    monit \
    # Log management
    logrotate \
    rsyslog \
    # Health monitoring
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create application user and directories
RUN groupadd -g 1000 mediaserver && \
    useradd -u 1000 -g 1000 -m -s /bin/bash mediaserver && \
    mkdir -p \
        /config/{caddy,jellyfin,sonarr,radarr,lidarr,prowlarr,qbittorrent,homepage,mcp-suite,prometheus,grafana,backup,security} \
        /data/{media/{movies,tv,music,books},downloads/{complete,incomplete},backup,logs} \
        /var/log/mediaserver \
        /etc/s6-overlay/s6-rc.d/{user/contents.d,init-setup} \
        /scripts/{backup,monitoring,security} \
    && chown -R mediaserver:mediaserver /config /data /var/log/mediaserver

# Install Homepage dependencies
RUN cd /opt/homepage && npm ci --production

# Create comprehensive service definitions with s6-overlay
RUN mkdir -p /etc/s6-overlay/s6-rc.d/{caddy,jellyfin,sonarr,radarr,lidarr,prowlarr,qbittorrent,homepage,prometheus,grafana,redis,backup-service,monitoring-service}/run && \
    # Set all services as longruns
    for service in caddy jellyfin sonarr radarr lidarr prowlarr qbittorrent homepage prometheus grafana redis backup-service monitoring-service; do \
        echo "longrun" > /etc/s6-overlay/s6-rc.d/$service/type && \
        touch /etc/s6-overlay/s6-rc.d/user/contents.d/$service; \
    done

# Create service run scripts
RUN cat > /etc/s6-overlay/s6-rc.d/caddy/run/run <<'EOF'
#!/command/with-contenv bash
echo "Starting Caddy reverse proxy..."
exec s6-setuidgid mediaserver /usr/local/bin/caddy run --config /config/caddy/Caddyfile --adapter caddyfile
EOF

RUN cat > /etc/s6-overlay/s6-rc.d/jellyfin/run/run <<'EOF'
#!/command/with-contenv bash
echo "Starting Jellyfin media server..."
export JELLYFIN_DATA_DIR=/config/jellyfin
export JELLYFIN_CONFIG_DIR=/config/jellyfin
export JELLYFIN_LOG_DIR=/config/jellyfin/log
export JELLYFIN_CACHE_DIR=/config/jellyfin/cache
exec s6-setuidgid mediaserver /usr/bin/jellyfin \
    --datadir $JELLYFIN_DATA_DIR \
    --configdir $JELLYFIN_CONFIG_DIR \
    --logdir $JELLYFIN_LOG_DIR \
    --cachedir $JELLYFIN_CACHE_DIR \
    --webdir /usr/share/jellyfin/web
EOF

RUN cat > /etc/s6-overlay/s6-rc.d/sonarr/run/run <<'EOF'
#!/command/with-contenv bash
echo "Starting Sonarr TV management..."
export HOME=/config/sonarr
exec s6-setuidgid mediaserver /opt/sonarr/Sonarr -nobrowser -data=/config/sonarr
EOF

RUN cat > /etc/s6-overlay/s6-rc.d/radarr/run/run <<'EOF'
#!/command/with-contenv bash
echo "Starting Radarr movie management..."
export HOME=/config/radarr
exec s6-setuidgid mediaserver /opt/radarr/Radarr -nobrowser -data=/config/radarr
EOF

RUN cat > /etc/s6-overlay/s6-rc.d/lidarr/run/run <<'EOF'
#!/command/with-contenv bash
echo "Starting Lidarr music management..."  
export HOME=/config/lidarr
exec s6-setuidgid mediaserver /opt/lidarr/Lidarr -nobrowser -data=/config/lidarr
EOF

RUN cat > /etc/s6-overlay/s6-rc.d/prowlarr/run/run <<'EOF'
#!/command/with-contenv bash
echo "Starting Prowlarr indexer management..."
export HOME=/config/prowlarr
exec s6-setuidgid mediaserver /opt/prowlarr/Prowlarr -nobrowser -data=/config/prowlarr
EOF

RUN cat > /etc/s6-overlay/s6-rc.d/qbittorrent/run/run <<'EOF'
#!/command/with-contenv bash
echo "Starting qBittorrent download client..."
exec s6-setuidgid mediaserver /usr/bin/qbittorrent-nox --webui-port=8080 --profile=/config/qbittorrent
EOF

RUN cat > /etc/s6-overlay/s6-rc.d/homepage/run/run <<'EOF'
#!/command/with-contenv bash
echo "Starting Ultimate Dashboard..."
cd /opt/homepage
export NODE_ENV=production
export PORT=3000
