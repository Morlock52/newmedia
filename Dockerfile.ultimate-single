# Ultimate Single Container Media Server with DevOps Automation
# Built for rapid deployment, monitoring, and management
# Features: All services, AI integration, monitoring, backup, security, auto-scaling

ARG BUILDPLATFORM=linux/amd64
ARG TARGETPLATFORM=linux/amd64

# Multi-stage build for optimal image size and security
FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS base-builder

# Build arguments for versions (Latest as of August 2025)
ARG S6_OVERLAY_VERSION=3.2.1.0
ARG CADDY_VERSION=2.8.4
ARG JELLYFIN_VERSION=10.10.6
ARG SONARR_VERSION=4.0.15.2941
ARG RADARR_VERSION=5.27.2.10142  
ARG LIDARR_VERSION=2.5.2.4316
ARG PROWLARR_VERSION=2.0.2.5116
ARG QBITTORRENT_VERSION=5.0.3
ARG HOMEPAGE_VERSION=1.4.2
ARG PROMETHEUS_VERSION=2.53.1
ARG GRAFANA_VERSION=11.1.4
ARG NODE_VERSION=20.15.1

# Security and optimization build args
ARG BUILDKIT_PROGRESS=plain
ARG TARGETARCH
ARG DEBIAN_FRONTEND=noninteractive

# Install build dependencies and tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build essentials
    build-essential \
    ca-certificates \
    curl \
    wget \
    git \
    gnupg \
    lsb-release \
    software-properties-common \
    apt-transport-https \
    # System utilities
    tzdata \
    locales \
    supervisor \
    cron \
    logrotate \
    rsyslog \
    # Security tools
    fail2ban \
    ufw \
    aide \
    rkhunter \
    # Monitoring and performance
    htop \
    iotop \
    netcat-openbsd \
    procps \
    psmisc \
    # Media processing
    mediainfo \
    ffmpeg \
    libva2 \
    libva-drm2 \
    mesa-va-drivers \
    i965-va-driver-shaders \
    intel-media-va-driver-non-free \
    # Development libraries
    libicu72 \
    libssl3 \
    libgdiplus \
    libc6-dev \
    libfontconfig1 \
    libfreetype6 \
    libgomp1 \
    # Python ecosystem
    python3 \
    python3-pip \
    python3-venv \
    # Database tools
    sqlite3 \
    postgresql-client \
    mariadb-client \
    redis-tools \
    # Archive tools
    unzip \
    xz-utils \
    tar \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen en_US.UTF-8

# Set locale and timezone
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    TZ=UTC

# Stage 1: Download and prepare s6-overlay for process management
FROM base-builder AS s6-downloader
ARG S6_OVERLAY_VERSION
ARG TARGETARCH

RUN case ${TARGETARCH} in \
        "amd64") S6_ARCH="x86_64" ;; \
        "arm64") S6_ARCH="aarch64" ;; \
        "arm") S6_ARCH="armhf" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" && exit 1 ;; \
    esac && \
    wget -q "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz" \
         "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-${S6_ARCH}.tar.xz" && \
    mkdir -p /s6-overlay && \
    tar -C /s6-overlay -Jxpf s6-overlay-noarch.tar.xz && \
    tar -C /s6-overlay -Jxpf s6-overlay-${S6_ARCH}.tar.xz && \
    rm -f *.tar.xz

# Stage 2: Download Caddy web server for reverse proxy
FROM caddy:${CADDY_VERSION}-alpine AS caddy-downloader

# Stage 3: Download and prepare *arr applications
FROM base-builder AS arr-downloader
ARG SONARR_VERSION
ARG RADARR_VERSION  
ARG LIDARR_VERSION
ARG PROWLARR_VERSION
ARG TARGETARCH

RUN case ${TARGETARCH} in \
        "amd64") ARR_ARCH="x64" ;; \
        "arm64") ARR_ARCH="arm64" ;; \
        "arm") ARR_ARCH="arm" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" && exit 1 ;; \
    esac && \
    mkdir -p /arr-apps && \
    # Download Sonarr
    wget -q "https://github.com/Sonarr/Sonarr/releases/download/v${SONARR_VERSION}/Sonarr.main.${SONARR_VERSION}.linux-${ARR_ARCH}.tar.gz" && \
    tar -xzf "Sonarr.main.${SONARR_VERSION}.linux-${ARR_ARCH}.tar.gz" -C /arr-apps && \
    mv /arr-apps/Sonarr /arr-apps/sonarr && \
    # Download Radarr
    wget -q "https://github.com/Radarr/Radarr/releases/download/v${RADARR_VERSION}/Radarr.master.${RADARR_VERSION}.linux-core-${ARR_ARCH}.tar.gz" && \
    tar -xzf "Radarr.master.${RADARR_VERSION}.linux-core-${ARR_ARCH}.tar.gz" -C /arr-apps && \
    mv /arr-apps/Radarr /arr-apps/radarr && \
    # Download Lidarr
    wget -q "https://github.com/Lidarr/Lidarr/releases/download/v${LIDARR_VERSION}/Lidarr.master.${LIDARR_VERSION}.linux-core-${ARR_ARCH}.tar.gz" && \
    tar -xzf "Lidarr.master.${LIDARR_VERSION}.linux-core-${ARR_ARCH}.tar.gz" -C /arr-apps && \
    mv /arr-apps/Lidarr /arr-apps/lidarr && \
    # Download Prowlarr
    wget -q "https://github.com/Prowlarr/Prowlarr/releases/download/v${PROWLARR_VERSION}/Prowlarr.master.${PROWLARR_VERSION}.linux-core-${ARR_ARCH}.tar.gz" && \
    tar -xzf "Prowlarr.master.${PROWLARR_VERSION}.linux-core-${ARR_ARCH}.tar.gz" -C /arr-apps && \
    mv /arr-apps/Prowlarr /arr-apps/prowlarr && \
    rm -f *.tar.gz

# Stage 4: Download monitoring tools (Prometheus, Grafana)
FROM base-builder AS monitoring-downloader
ARG PROMETHEUS_VERSION
ARG GRAFANA_VERSION
ARG TARGETARCH

RUN case ${TARGETARCH} in \
        "amd64") PROM_ARCH="amd64" ;; \
        "arm64") PROM_ARCH="arm64" ;; \
        "arm") PROM_ARCH="armv7" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" && exit 1 ;; \
    esac && \
    mkdir -p /monitoring && \
    # Download Prometheus
    wget -q "https://github.com/prometheus/prometheus/releases/download/v${PROMETHEUS_VERSION}/prometheus-${PROMETHEUS_VERSION}.linux-${PROM_ARCH}.tar.gz" && \
    tar -xzf "prometheus-${PROMETHEUS_VERSION}.linux-${PROM_ARCH}.tar.gz" && \
    mv prometheus-${PROMETHEUS_VERSION}.linux-${PROM_ARCH} /monitoring/prometheus && \
    # Download Grafana
    case ${TARGETARCH} in \
        "amd64") GRAFANA_ARCH="amd64" ;; \
        "arm64") GRAFANA_ARCH="arm64" ;; \
        "arm") GRAFANA_ARCH="armv7" ;; \
    esac && \
    wget -q "https://dl.grafana.com/oss/release/grafana-${GRAFANA_VERSION}.linux-${GRAFANA_ARCH}.tar.gz" && \
    tar -xzf "grafana-${GRAFANA_VERSION}.linux-${GRAFANA_ARCH}.tar.gz" && \
    mv grafana-v${GRAFANA_VERSION} /monitoring/grafana && \
    rm -f *.tar.gz

# Stage 5: Build AI/MCP Suite and Dashboard
FROM node:${NODE_VERSION}-alpine AS node-builder
ARG HOMEPAGE_VERSION

# Create optimized homepage dashboard
RUN mkdir -p /homepage-dist && \
    cat > /homepage-dist/package.json <<'EOF'
{
  "name": "ultimate-media-dashboard",
  "version": "2.0.0",
  "description": "Ultimate Media Server Dashboard with AI Integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "node-cron": "^3.0.3",
    "axios": "^1.7.2"
  }
}
EOF

# Install dependencies and create server
RUN cd /homepage-dist && npm install --production && \
    cat > /homepage-dist/server.js <<'EOF'
const express = require('express');
const http = require('http');
const WebSocket = require('ws');
const cron = require('node-cron');
const axios = require('axios');
const fs = require('fs');
const path = require('path');

const app = express();
const server = http.createServer(app);
const wss = new WebSocket.Server({ server });

app.use(express.static('public'));
app.use(express.json());

// Service health monitoring
const services = [
  { name: 'Jellyfin', url: 'http://localhost:8096/health', port: 8096 },
  { name: 'Sonarr', url: 'http://localhost:8989/ping', port: 8989 },
  { name: 'Radarr', url: 'http://localhost:7878/ping', port: 7878 },
  { name: 'Lidarr', url: 'http://localhost:8686/ping', port: 8686 },
  { name: 'Prowlarr', url: 'http://localhost:9696/ping', port: 9696 },
  { name: 'qBittorrent', url: 'http://localhost:8080', port: 8080 },
  { name: 'Prometheus', url: 'http://localhost:9090/-/healthy', port: 9090 },
  { name: 'Grafana', url: 'http://localhost:3001/api/health', port: 3001 }
];

let healthStatus = {};

// Health check function
async function checkHealth() {
  for (const service of services) {
    try {
      await axios.get(service.url, { timeout: 5000 });
      healthStatus[service.name] = { status: 'up', lastCheck: new Date() };
    } catch (error) {
      healthStatus[service.name] = { status: 'down', lastCheck: new Date(), error: error.message };
    }
  }
  
  // Broadcast to all WebSocket clients
  wss.clients.forEach(client => {
    if (client.readyState === WebSocket.OPEN) {
      client.send(JSON.stringify({ type: 'health', data: healthStatus }));
    }
  });
}

// Schedule health checks every 30 seconds
cron.schedule('*/30 * * * * *', checkHealth);

// API endpoints
app.get('/api/health', (req, res) => {
  res.json(healthStatus);
});

app.get('/api/stats', async (req, res) => {
  try {
    // Get system stats from Prometheus if available
    const stats = {
      uptime: process.uptime(),
      memory: process.memoryUsage(),
      timestamp: new Date()
    };
    res.json(stats);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

// WebSocket connection
wss.on('connection', (ws) => {
  console.log('Dashboard client connected');
  ws.send(JSON.stringify({ type: 'health', data: healthStatus }));
  
  ws.on('close', () => {
    console.log('Dashboard client disconnected');
  });
});

// Initial health check
checkHealth();

const PORT = process.env.PORT || 3000;
server.listen(PORT, () => {
  console.log(`Ultimate Media Dashboard running on port ${PORT}`);
});
EOF

