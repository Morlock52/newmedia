#!/bin/bash
set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

SERVICES_UP=0
TOTAL_SERVICES=9
HEALTH_SCORE=0

echo -e "${YELLOW}🔍 Ultimate Media Server Health Check${NC}"
echo "=================================="

# Function to check service health
check_service() {
    local name="$1"
    local port="$2"
    local endpoint="$3"
    local timeout="$4"
    
    if timeout "$timeout" curl -sf "http://localhost:${port}${endpoint}" >/dev/null 2>&1; then
        echo -e "✅ ${GREEN}$name${NC} - Running on port $port"
        SERVICES_UP=$((SERVICES_UP + 1))
        HEALTH_SCORE=$((HEALTH_SCORE + 10))
        return 0
    else
        echo -e "❌ ${RED}$name${NC} - Not responding on port $port"
        return 1
    fi
}

# Check core services
echo -e "\n${YELLOW}Core Services:${NC}"
check_service "Caddy Proxy" "80" "/health" "5"
check_service "Jellyfin" "8096" "/health" "10"
check_service "Dashboard" "3000" "/api/health" "5"

echo -e "\n${YELLOW}Media Management:${NC}"
check_service "Sonarr" "8989" "/ping" "10"
check_service "Radarr" "7878" "/ping" "10" 
check_service "Lidarr" "8686" "/ping" "10"
check_service "Prowlarr" "9696" "/ping" "10"

echo -e "\n${YELLOW}Downloads & Monitoring:${NC}"
check_service "qBittorrent" "8080" "/" "5"
check_service "Prometheus" "9090" "/-/healthy" "5"

# Additional health metrics
echo -e "\n${YELLOW}System Health:${NC}"

# Memory check
MEMORY_USAGE=$(free | awk 'NR==2{printf "%.1f", $3*100/$2}')
if (( $(echo "$MEMORY_USAGE < 85" | bc -l) )); then
    echo -e "✅ ${GREEN}Memory Usage${NC} - ${MEMORY_USAGE}%"
    HEALTH_SCORE=$((HEALTH_SCORE + 5))
else
    echo -e "⚠️ ${YELLOW}Memory Usage${NC} - ${MEMORY_USAGE}% (High)"
fi

# Disk check
DISK_USAGE=$(df /data | awk 'NR==2{print $5}' | sed 's/%//')
if [ "$DISK_USAGE" -lt 85 ]; then
    echo -e "✅ ${GREEN}Disk Usage${NC} - ${DISK_USAGE}%"
    HEALTH_SCORE=$((HEALTH_SCORE + 5))
else
    echo -e "⚠️ ${YELLOW}Disk Usage${NC} - ${DISK_USAGE}% (High)"
fi

# Calculate final health score
MAX_SCORE=100
HEALTH_PERCENTAGE=$((HEALTH_SCORE * 100 / MAX_SCORE))

echo -e "\n${YELLOW}Overall Health:${NC}"
echo "Services: $SERVICES_UP/$TOTAL_SERVICES running"
echo "Health Score: $HEALTH_PERCENTAGE/100"

if [ $HEALTH_PERCENTAGE -gt 80 ]; then
    echo -e "Status: ${GREEN}EXCELLENT${NC} 🟢"
    exit 0
elif [ $HEALTH_PERCENTAGE -gt 60 ]; then
    echo -e "Status: ${YELLOW}GOOD${NC} 🟡"
    exit 0
elif [ $HEALTH_PERCENTAGE -gt 40 ]; then
    echo -e "Status: ${YELLOW}DEGRADED${NC} 🟠"
    exit 1
else
    echo -e "Status: ${RED}CRITICAL${NC} 🔴"
    exit 1
fi
EOF

