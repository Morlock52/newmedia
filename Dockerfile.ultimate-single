RETENTION_DAYS=${BACKUP_RETENTION_DAYS:-7}

echo "🔄 Backup daemon started (retention: ${RETENTION_DAYS} days)"

# Create backup function
perform_backup() {
    local timestamp=$(date +%Y%m%d_%H%M%S)
    local backup_file="${BACKUP_DIR}/config_backup_${timestamp}.tar.gz"
    
    echo "📦 Creating backup: $backup_file"
    
    # Create compressed backup
    tar -czf "$backup_file" -C /config . 2>/dev/null || {
        echo "❌ Backup failed"
        return 1
    }
    
    # Cleanup old backups
    find "$BACKUP_DIR" -name "config_backup_*.tar.gz" -mtime +$RETENTION_DAYS -delete
    
    echo "✅ Backup completed: $(du -h "$backup_file" | cut -f1)"
}

# Initial backup
mkdir -p "$BACKUP_DIR"
perform_backup

# Schedule backups every 6 hours
while true; do
    sleep 21600  # 6 hours
    perform_backup
done
EOF

RUN cat > /scripts/monitoring/monitor-daemon.sh <<'EOF'
#!/bin/bash
set -e

LOG_FILE="/var/log/mediaserver/monitoring.log"
mkdir -p "$(dirname "$LOG_FILE")"

echo "📊 Monitoring daemon started" | tee -a "$LOG_FILE"

# Service monitoring function
check_services() {
    local services=(
        "jellyfin:8096:/health"
        "sonarr:8989:/ping" 
        "radarr:7878:/ping"
        "lidarr:8686:/ping"
        "prowlarr:9696:/ping"
        "qbittorrent:8080:/"
        "homepage:3000:/api/health"
        "prometheus:9090:/-/healthy"
        "grafana:3001:/api/health"
    )
    
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local all_healthy=true
    
    for service_info in "${services[@]}"; do
        IFS=':' read -r service port endpoint <<< "$service_info"
        
        if curl -sf "http://localhost:${port}${endpoint}" >/dev/null 2>&1; then
            echo "[$timestamp] ✅ $service - OK" >> "$LOG_FILE"
        else
            echo "[$timestamp] ❌ $service - DOWN" >> "$LOG_FILE"
            all_healthy=false
        fi
    done
    
    if [ "$all_healthy" = true ]; then
        echo "[$timestamp] 🟢 All services healthy" >> "$LOG_FILE"
    else
        echo "[$timestamp] 🔴 Some services are down" >> "$LOG_FILE"
    fi
}

# Monitor resources
check_resources() {
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local memory_usage=$(free | awk 'NR==2{printf "%.1f", $3*100/$2}')
    local disk_usage=$(df /data | awk 'NR==2{print $5}' | sed 's/%//')
    
    echo "[$timestamp] 💾 Memory: ${memory_usage}% | Disk: ${disk_usage}%" >> "$LOG_FILE"
    
    # Alert if usage is high
    if (( $(echo "$memory_usage > 85" | bc -l) )); then
        echo "[$timestamp] ⚠️ HIGH MEMORY USAGE: ${memory_usage}%" >> "$LOG_FILE"
    fi
    
    if [ "$disk_usage" -gt 85 ]; then
        echo "[$timestamp] ⚠️ HIGH DISK USAGE: ${disk_usage}%" >> "$LOG_FILE"
    fi
}

# Main monitoring loop
while true; do
    check_services
    check_resources
    
    # Rotate log file if it gets too large (>10MB)
    if [ -f "$LOG_FILE" ] && [ $(stat -f%z "$LOG_FILE" 2>/dev/null || stat -c%s "$LOG_FILE") -gt 10485760 ]; then
        mv "$LOG_FILE" "${LOG_FILE}.old"
        echo "$(date '+%Y-%m-%d %H:%M:%S') 📋 Log rotated" > "$LOG_FILE"
    fi
    
    sleep 60  # Check every minute
done
EOF

