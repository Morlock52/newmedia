# Ultimate Single Container Media Server with AI
# 30+ Services with Full Interconnection
# August 2025 - Production Ready

FROM ubuntu:24.04 AS base

# Metadata
LABEL maintainer="Media Server AI"
LABEL version="2025.08.09"
LABEL description="Complete media server with 30+ services and AI features"

# Environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    S6_OVERLAY_VERSION=3.1.6.2 \
    NODE_VERSION=20 \
    PYTHON_VERSION=3.11 \
    TZ=UTC \
    PUID=1000 \
    PGID=1000

# Install xz-utils first for extracting s6-overlay
RUN apt-get update && apt-get install -y xz-utils && rm -rf /var/lib/apt/lists/*

# Install s6-overlay for process management
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz /tmp
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-x86_64.tar.xz /tmp
RUN tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz && \
    tar -C / -Jxpf /tmp/s6-overlay-x86_64.tar.xz && \
    rm /tmp/*.tar.xz

# Install base dependencies
RUN apt-get update && apt-get install -y \
    # System utilities
    curl wget git vim nano htop \
    software-properties-common \
    apt-transport-https \
    ca-certificates \
    gnupg lsb-release \
    build-essential \
    pkg-config \
    # Network tools
    net-tools iputils-ping \
    dnsutils netcat \
    # Process management
    supervisor \
    # Database clients
    postgresql-client \
    redis-tools \
    sqlite3 \
    # Python
    python3.11 python3.11-dev python3-pip \
    # Node.js
    nodejs npm \
    # Media tools
    ffmpeg mediainfo \
    # Security
    openssl \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI for container management
RUN curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null && \
    apt-get update && apt-get install -y docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

# Install Traefik for service mesh
RUN wget -O /usr/local/bin/traefik https://github.com/traefik/traefik/releases/download/v3.0.0/traefik_v3.0.0_linux_amd64.tar.gz && \
    chmod +x /usr/local/bin/traefik

# Create application directories
RUN mkdir -p \
    /app \
    /config \
    /data \
    /media \
    /downloads \
    /logs \
    /var/run/s6 \
    /etc/s6-overlay/s6-rc.d

# Install Node.js global packages
RUN npm install -g \
    pm2 \
    pnpm \
    yarn \
    typescript \
    @nestjs/cli \
    next

# Install Python packages
RUN pip3 install --no-cache-dir \
    uvicorn \
    fastapi \
    celery \
    redis \
    psycopg2-binary \
    sqlalchemy \
    alembic \
    requests \
    aiohttp \
    websockets \
    pydantic \
    python-multipart \
    python-jose[cryptography] \
    passlib[bcrypt] \
    python-dotenv \
    loguru \
    prometheus-client \
    transformers \
    torch \
    torchvision \
    scikit-learn \
    pandas \
    numpy

# Stage 2: Media Services Installation
FROM base AS media-services

# Install Jellyfin
RUN wget -O - https://repo.jellyfin.org/jellyfin_team.gpg.key | apt-key add - && \
    echo "deb [arch=$( dpkg --print-architecture )] https://repo.jellyfin.org/$( awk -F'=' '/^ID=/{ print $NF }' /etc/os-release ) $( awk -F'=' '/^VERSION_CODENAME=/{ print $NF }' /etc/os-release ) main" | tee /etc/apt/sources.list.d/jellyfin.list && \
    apt-get update && \
    apt-get install -y jellyfin && \
    rm -rf /var/lib/apt/lists/*

# Install Plex (using Docker image extraction method)
RUN mkdir -p /opt/plex && \
    wget -O /tmp/plex.tar https://downloads.plex.tv/plex-media-server-new/1.32.8.7639-fb6452ebf/debian/plexmediaserver_1.32.8.7639-fb6452ebf_amd64.deb && \
    dpkg -i /tmp/plex.tar || apt-get install -f -y && \
    rm /tmp/plex.tar

# Install *arr stack services
RUN mkdir -p /opt/sonarr /opt/radarr /opt/lidarr /opt/readarr /opt/prowlarr /opt/bazarr

# Sonarr
RUN wget -O /tmp/sonarr.tar.gz https://github.com/Sonarr/Sonarr/releases/download/v4.0.0.748/Sonarr.main.4.0.0.748.linux-x64.tar.gz && \
    tar -xzf /tmp/sonarr.tar.gz -C /opt/sonarr && \
    rm /tmp/sonarr.tar.gz

# Radarr
RUN wget -O /tmp/radarr.tar.gz https://github.com/Radarr/Radarr/releases/download/v5.2.6.8376/Radarr.master.5.2.6.8376.linux-core-x64.tar.gz && \
    tar -xzf /tmp/radarr.tar.gz -C /opt/radarr && \
    rm /tmp/radarr.tar.gz

# Prowlarr
RUN wget -O /tmp/prowlarr.tar.gz https://github.com/Prowlarr/Prowlarr/releases/download/v1.11.4.4173/Prowlarr.master.1.11.4.4173.linux-core-x64.tar.gz && \
    tar -xzf /tmp/prowlarr.tar.gz -C /opt/prowlarr && \
    rm /tmp/prowlarr.tar.gz

# Install download clients
RUN apt-get update && apt-get install -y \
    qbittorrent-nox \
    transmission-daemon \
    sabnzbdplus \
    && rm -rf /var/lib/apt/lists/*

# Stage 3: AI Services
FROM media-services AS ai-services

# Copy AI service files
COPY ai-safety-system.py /app/ai/
COPY content-moderation.js /app/ai/
COPY recommendation-engine.py /app/ai/
COPY social-media-integration.js /app/ai/

# Create AI model directories
RUN mkdir -p /app/models /app/ai/data

# Stage 4: Frontend Dashboard
FROM ai-services AS frontend

# Copy Next.js dashboard
COPY dashboard/ /app/dashboard/

# Build dashboard
WORKDIR /app/dashboard
RUN npm install && npm run build

# Stage 5: Configuration and Services
FROM frontend AS final

# Copy service configurations
COPY configs/ /config/
COPY scripts/ /scripts/

# Create s6-overlay service definitions
COPY s6-services/ /etc/s6-overlay/s6-rc.d/

# Copy Traefik configuration
COPY traefik.yml /etc/traefik/traefik.yml
COPY traefik-dynamic.yml /etc/traefik/dynamic/

# Create unified entrypoint script
COPY docker-entrypoint.sh /
RUN chmod +x /docker-entrypoint.sh

# Copy health check script
COPY healthcheck-all.sh /
RUN chmod +x /healthcheck-all.sh

# Set up volumes
VOLUME ["/config", "/data", "/media", "/downloads", "/logs"]

# Expose all service ports
# Media servers
EXPOSE 8096 32400 8920
# *arr stack
EXPOSE 8989 7878 8686 8787 9696 6767
# Download clients
EXPOSE 8080 9091 8081 6789
# Request services
EXPOSE 5055 5056 3579
# AI services
EXPOSE 8090 8091 8092 8093 8094 8095
# Monitoring
EXPOSE 3000 3001 9090 5601
# Dashboard
EXPOSE 3000
# Traefik
EXPOSE 80 443 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5m --retries=3 \
    CMD /healthcheck-all.sh || exit 1

# Set entrypoint to s6-overlay
ENTRYPOINT ["/init"]

# Default command
CMD ["/docker-entrypoint.sh"]