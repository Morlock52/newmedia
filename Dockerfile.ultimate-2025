# Ultimate Media Server 2025 - Single Container Solution
# Optimized multi-stage build with s6-overlay for process management
# Built: August 2025 - Latest practices

FROM node:20-alpine AS dashboard-builder
WORKDIR /app/dashboard
COPY dashboard/package*.json ./
RUN npm ci --production=false
COPY dashboard/ ./
RUN npm run build

FROM node:20-alpine AS api-builder
WORKDIR /app/api  
COPY api/package*.json ./
RUN npm ci --production
COPY api/ ./

FROM ubuntu:24.04

# Install s6-overlay for process management
ARG S6_OVERLAY_VERSION=3.1.6.2
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz /tmp
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-x86_64.tar.xz /tmp
RUN tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz && \
    tar -C / -Jxpf /tmp/s6-overlay-x86_64.tar.xz && \
    rm -rf /tmp/*.tar.xz

# Environment setup
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=America/New_York \
    PUID=1000 \
    PGID=1000 \
    S6_BEHAVIOUR_IF_STAGE2_FAILS=2 \
    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0

# Install all dependencies and media services
RUN apt-get update && apt-get install -y \
    # System utilities
    curl wget gnupg lsb-release ca-certificates \
    software-properties-common apt-transport-https \
    # Process management
    supervisor \
    # Media dependencies
    ffmpeg mediainfo \
    # Python for SABnzbd
    python3 python3-pip \
    # Node.js for dashboard
    nodejs npm \
    # Caddy
    debian-keyring debian-archive-keyring \
    && rm -rf /var/lib/apt/lists/*

# Install Caddy
RUN curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg && \
    curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | tee /etc/apt/sources.list.d/caddy-stable.list && \
    apt-get update && apt-get install -y caddy && \
    rm -rf /var/lib/apt/lists/*

# Install Jellyfin
RUN curl -fsSL https://repo.jellyfin.org/ubuntu/jellyfin_team.gpg.key | gpg --dearmor -o /usr/share/keyrings/jellyfin-keyring.gpg && \
    echo "deb [arch=$( dpkg --print-architecture ) signed-by=/usr/share/keyrings/jellyfin-keyring.gpg] https://repo.jellyfin.org/ubuntu $( lsb_release -c -s ) main" | tee /etc/apt/sources.list.d/jellyfin.list && \
    apt-get update && apt-get install -y jellyfin && \
    rm -rf /var/lib/apt/lists/*

# Install Mono for Sonarr/Radarr/Lidarr
RUN apt-key adv --keyserver hkp://keyserver.ubuntu.com:80 --recv-keys 3FA7E0328081BFF6A14DA29AA6A19B38D3D831EF && \
    echo "deb https://download.mono-project.com/repo/ubuntu stable-focal main" | tee /etc/apt/sources.list.d/mono-official-stable.list && \
    apt-get update && apt-get install -y mono-complete && \
    rm -rf /var/lib/apt/lists/*

# Download and extract media management apps
WORKDIR /opt

# Sonarr
RUN wget -O Sonarr.tar.gz "https://services.sonarr.tv/v1/download/main/latest?version=4&os=linux&arch=x64" && \
    tar -xzf Sonarr.tar.gz && \
    rm Sonarr.tar.gz

# Radarr  
RUN wget -O Radarr.tar.gz "https://radarr.servarr.com/v1/update/master/updatefile?os=linux&runtime=netcore&arch=x64" && \
    tar -xzf Radarr.tar.gz && \
    rm Radarr.tar.gz

# Lidarr
RUN wget -O Lidarr.tar.gz "https://lidarr.servarr.com/v1/update/master/updatefile?os=linux&runtime=netcore&arch=x64" && \
    tar -xzf Lidarr.tar.gz && \
    rm Lidarr.tar.gz

# Prowlarr
RUN wget -O Prowlarr.tar.gz "https://prowlarr.servarr.com/v1/update/master/updatefile?os=linux&runtime=netcore&arch=x64" && \
    tar -xzf Prowlarr.tar.gz && \
    rm Prowlarr.tar.gz

# Bazarr
RUN wget -O bazarr.zip "https://github.com/morpheus65535/bazarr/releases/latest/download/bazarr.zip" && \
    unzip bazarr.zip -d /opt/bazarr && \
    rm bazarr.zip && \
    pip3 install -r /opt/bazarr/requirements.txt

# qBittorrent
RUN add-apt-repository ppa:qbittorrent-team/qbittorrent-stable -y && \
    apt-get update && apt-get install -y qbittorrent-nox && \
    rm -rf /var/lib/apt/lists/*

# SABnzbd
RUN add-apt-repository ppa:jcfp/nobetas -y && \
    apt-get update && apt-get install -y sabnzbdplus && \
    rm -rf /var/lib/apt/lists/*

# Transmission
RUN apt-get update && apt-get install -y transmission-daemon && \
    rm -rf /var/lib/apt/lists/*

# Install Uptime Kuma
RUN git clone https://github.com/louislam/uptime-kuma.git /opt/uptime-kuma && \
    cd /opt/uptime-kuma && \
    npm ci --production && \
    npm run download-dist

# Copy built dashboard and API
COPY --from=dashboard-builder /app/dashboard/dist /opt/dashboard
COPY --from=api-builder /app/api /opt/api

# Create directories
RUN mkdir -p \
    /config \
    /data/media/movies \
    /data/media/tv \
    /data/media/music \
    /data/downloads/complete \
    /data/downloads/incomplete \
    /etc/services.d

# Copy s6 service definitions
COPY s6-services/ /etc/services.d/

# Copy Caddyfile
COPY Caddyfile /etc/caddy/Caddyfile

# Copy startup script
COPY start-services.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/start-services.sh

# Expose ports
EXPOSE 80 443 8096 8989 7878 8686 9696 6767 8080 8085 9091 3001 3002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Set up volumes
VOLUME ["/config", "/data"]

# Use s6-overlay as init
ENTRYPOINT ["/init"]