FROM node:25-bullseye-slim

WORKDIR /app

# Environment
ENV NODE_ENV=production \
    API_PORT=3333

# Install minimal runtime dependencies for the real backend
COPY docker/backend-package.json ./package.json
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    python3-dev \
    pkg-config \
    libopus-dev \
    libvpx-dev \
    libssl-dev \
    curl \
    wget \
    ca-certificates && rm -rf /var/lib/apt/lists/*
RUN npm install --omit=dev --no-audit --no-fund

# Copy server and optional compose file for service discovery
COPY real-backend-server.js ./real-backend-server.js
COPY ../scripts/console-shim.js ./scripts/console-shim.js
COPY docker-compose.yml ./docker-compose.yml

# Expose backend port
EXPOSE 3333

# Healthcheck against the API
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD wget -qO- http://localhost:3333/health || exit 1

CMD ["node", "-r", "./scripts/console-shim.js", "real-backend-server.js"]
