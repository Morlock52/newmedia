{
  "title": "Traefik Overview (Minimal)",
  "uid": "traefik-overview-min",
  "schemaVersion": 38,
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "Requests (rate)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum(rate(traefik_entrypoint_requests_total[1m]))", "legendFormat": "req/s" }
      ]
    },
    {
      "type": "stat",
      "title": "5xx Responses (rate)",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum(rate(traefik_entrypoint_requests_total{code=~\"5..\"}[1m]))", "legendFormat": "5xx/s" }
      ]
    },
    {
      "type": "graph",
      "title": "EntryPoint Request Duration (p50/p90)",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 10 },
      "lines": true,
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(traefik_entrypoint_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.9, sum(rate(traefik_entrypoint_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p90" }
      ]
    }
  ]
}
