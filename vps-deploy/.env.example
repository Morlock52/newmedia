# ===== VPS Deployment Env =====
# Core
PUID=1000
PGID=1000
TZ=UTC

# Domain config (use your domain)
DOMAIN=example.com
ACME_EMAIL=you@example.com

# Choose certificate resolver: http or cloudflare
TRAEFIK_CERT_RESOLVER=http

# Protect Traefik dashboard with basic auth (username:hashed_password)
# Generate a bcrypt hash: htpasswd -nbBC 10 admin 'yourpassword' | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$2y$10$REPLACE_WITH_YOUR_HASH

# Cloudflare (if using DNS challenge and wildcard certs)
CF_API_EMAIL=
CF_DNS_API_TOKEN=

# Paths on VPS for media and downloads
MEDIA_PATH=/srv/media
DOWNLOADS_PATH=/srv/downloads


# ===== VPN (gluetun) =====
# See https://github.com/qdm12/gluetun for provider-specific values
VPN_PROVIDER=custom
VPN_TYPE=openvpn
VPN_USER=
VPN_PASSWORD=
# Optional: narrow by country/city
VPN_COUNTRY=
VPN_CITY=

# Toggle routing Prowlarr via VPN (gluetun). If true, script will start `prowlarr-vpn` and stop `prowlarr`.
PROWLARR_VPN=false

# Request portal selection: overseerr or jellyseerr
REQUEST_PORTAL=overseerr

# qBittorrent credentials (for auto-configuration in Sonarr/Radarr)
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# Uptime Kuma admin (optional for automated monitor provisioning)
UPTIME_KUMA_USERNAME=
UPTIME_KUMA_PASSWORD=

# Uptime Kuma optional monitors for external services
UPTIME_MONITOR_GRAFANA=false
UPTIME_MONITOR_PROMETHEUS=false
